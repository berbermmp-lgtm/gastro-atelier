<!DOCTYPE html>
<!DOCTYPE html>

<html lang="uk">
<head>
<meta charset="utf-8"/><meta content="width=device-width, initial-scale=1, viewport-fit=cover" name="viewport"/>
<title>Gastro Atelier — відкриття закладів під ключ в Україні</title>
<meta content="Gastro Atelier — відкриття ресторанів, кафе, кав’ярень та стрітфуду під ключ по всій Україні. Понад 20 проєктів у досвіді команди. Від ідеї до першого гостя." name="description"/>
<meta content="#211710" name="theme-color"/>
<link href="https://fonts.googleapis.com" rel="preconnect"/><link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&amp;family=Manrope:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
<link href="assets/favicon.svg" rel="icon" type="image/svg+xml"/>
<style>
:root{--ink:#171511;--black:#11110f;--earth:#28241f;--cream:#eee8de;--cream2:#f8f4ec;--gold:#bb9575;--line:rgba(46,38,30,.21);--wh:rgba(255,250,243,.88);--ease:cubic-bezier(.22,1,.36,1);--container:min(100% - 120px,1470px)}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:80px}body{margin:0;background:var(--cream2);color:var(--ink);font:400 15px/1.7 Manrope,Arial,sans-serif;-webkit-font-smoothing:antialiased}body.menu-open,body.dialog-open{overflow:hidden}::selection{background:var(--gold);color:#14100e}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}button{cursor:pointer}img{display:block;width:100%;height:100%;object-fit:cover}figure{margin:0}h1,h2,h3,p{margin-top:0}h1,h2,h3{font-weight:400}h1,h2,.serif{font-family:"Cormorant Garamond",Georgia,serif}h1 em,h2 em{font-weight:400}.container{width:var(--container);margin:auto}.label{display:flex;align-items:center;gap:12px;text-transform:uppercase;letter-spacing:.25em;font-size:10px;font-weight:700}.label:before{content:"";width:26px;height:1px;background:currentColor;opacity:.65}.light-label{color:#d9c2a8}.big-title{font-size:clamp(57px,7.3vw,126px);letter-spacing:-.053em;line-height:.88;margin:20px 0 33px}.big-title em{font-style:italic;color:#a78366}.intro-title{font-size:clamp(47px,5.2vw,93px);letter-spacing:-.043em;line-height:.98;margin:18px 0 25px}.intro-title em{color:#a68062}.description{color:#6c6259;font-size:15px;line-height:1.9}.display-arrow{font-size:24px;line-height:1;font-weight:400}.button{display:inline-flex;align-items:center;justify-content:space-between;gap:32px;min-height:56px;padding:0 25px;border:1px solid transparent;background:var(--cream);color:var(--ink);font-size:12px;font-weight:800;letter-spacing:.015em;border-radius:2px;transition:background .3s,transform .3s,border-color .3s}.button:hover{transform:translateY(-3px);background:#fff}.button-dark{background:var(--ink);color:#f5efe6}.button-dark:hover{background:#41352c}.button-outline{border-color:rgba(255,255,255,.45);background:transparent;color:white}.button-outline:hover{background:rgba(255,255,255,.12)}.button-secondary{border-color:var(--ink);background:transparent;color:var(--ink)}.button-secondary:hover{background:#e4dacd}.text-link{display:inline-flex;align-items:center;gap:18px;font-size:12px;text-transform:uppercase;letter-spacing:.12em;font-weight:800;border-bottom:1px solid;padding-bottom:9px;transition:gap .25s}.text-link:hover{gap:27px}
.progress{position:fixed;top:0;left:0;z-index:120;width:0;height:2px;background:#e5c69f;pointer-events:none}.site-header{height:102px;position:absolute;top:0;left:0;right:0;z-index:100;display:flex;align-items:center;color:#f6efe4;transition:background .25s,height .25s,border-color .25s}.site-header.is-scrolled{position:fixed;height:74px;background:rgba(20,18,15,.95);border-bottom:1px solid rgba(255,255,255,.12);backdrop-filter:blur(18px)}.header-inner{width:var(--container);margin:auto;display:flex;align-items:center;justify-content:space-between;gap:25px}.brand{display:inline-flex;align-items:center;gap:15px;min-width:200px}.brand svg{height:42px;width:39px;flex:none}.brand-type{display:flex;flex-direction:column;line-height:1.1}.brand-type strong{font-size:15px;font-weight:600;letter-spacing:.23em;white-space:nowrap}.brand-type small{font-size:6.7px;letter-spacing:.35em;margin-top:8px;white-space:nowrap;opacity:.7}.nav-links{display:flex;align-items:center;gap:clamp(16px,2vw,36px)}.nav-links a{white-space:nowrap;font-size:11px;font-weight:600;opacity:.8;transition:opacity .25s}.nav-links a:hover{opacity:1}.header-cta{border:1px solid rgba(255,250,240,.7);color:#f8eee0;padding:13px 20px;letter-spacing:0;font-weight:700;font-size:11px;white-space:nowrap;transition:background .2s,color .2s}.header-cta:hover{color:#211b16;background:#f7eee1}.menu-toggle{display:none;background:none;border:1px solid rgba(255,255,255,.35);color:white;width:46px;height:46px;border-radius:2px;align-items:center;justify-content:center}.menu-lines{display:flex;flex-direction:column;gap:6px}.menu-lines i{display:block;height:1px;width:20px;background:currentColor}.mobile-menu{display:none}
.hero{height:min(970px,100svh);min-height:740px;position:relative;background:#100e0c;color:var(--cream2);overflow:hidden;isolation:isolate}.hero-photo{position:absolute;inset:0;background-image:url('assets/hero.webp');background-size:cover;background-position:center center;transform:scale(1.08);animation:heroZoom 1.7s var(--ease) both;z-index:-3}.hero:before{content:"";inset:0;position:absolute;z-index:-2;background:linear-gradient(90deg,rgba(12,11,10,.88) 0%,rgba(12,11,10,.70) 29%,rgba(12,11,10,.28) 63%,rgba(12,11,10,.03) 100%),linear-gradient(0deg,rgba(9,9,8,.86) 0%,transparent 41%,rgba(8,7,7,.42) 100%)}.hero:after{content:"";position:absolute;z-index:-1;inset:0;background:radial-gradient(circle at 87% 35%,rgba(215,142,78,.11),transparent 47%);pointer-events:none}.hero-content{position:relative;height:100%;display:flex;flex-direction:column;justify-content:center;padding-top:80px;padding-bottom:138px}.hero .hero-label{margin-bottom:19px;color:#dfc7aa;animation:rise .9s .15s both}.hero h1{font-size:clamp(76px,9.3vw,174px);max-width:1030px;line-height:.8;letter-spacing:-.065em;margin:0 0 35px;animation:rise 1s .25s both}.hero h1 em{color:#e3c7ad}.hero-copy{max-width:465px;font-size:15px;line-height:1.85;color:#e7dacf;margin-bottom:32px;animation:rise 1s .38s both}.hero-actions{display:flex;align-items:center;gap:28px;flex-wrap:wrap;animation:rise 1s .5s both}.hero-scroll{position:absolute;right:0;bottom:176px;writing-mode:vertical-rl;font-size:9px;letter-spacing:.28em;text-transform:uppercase;color:#d6c6b5;display:flex;align-items:center;gap:18px}.hero-scroll:after{content:"";height:74px;width:1px;background:#d6c6b5}.hero-stats{position:absolute;bottom:0;left:0;right:0;border-top:1px solid rgba(255,248,235,.22);background:linear-gradient(90deg,rgba(20,17,14,.5),rgba(20,17,14,.12));backdrop-filter:blur(6px)}.stats-grid{display:grid;grid-template-columns:1fr 1fr 1fr 1.15fr;padding-top:27px;padding-bottom:31px}.stat{padding:0 31px;border-left:1px solid rgba(255,248,235,.25)}.stat:first-child{padding-left:0;border-left:0}.stat-number{font-family:"Cormorant Garamond",Georgia,serif;font-size:clamp(29px,3vw,51px);line-height:1;margin-bottom:4px;white-space:nowrap}.stat-caption{font-size:10px;color:#d3c3b5}.stat:last-child .stat-number{font-size:clamp(25px,2.45vw,44px)}
.section{padding:120px 0}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:45px}.section-heading .intro-title{margin-bottom:0}.section-heading .description{max-width:390px;margin:0}.intro{background:var(--cream2);padding:133px 0 126px}.intro-grid{display:grid;grid-template-columns:1fr 1fr;gap:9%;align-items:start}.intro-copy{max-width:575px}.intro-copy .description{max-width:490px}.intro-bottom{margin-top:69px;border-top:1px solid var(--line);padding-top:24px;display:flex;align-items:center;gap:29px}.intro-bottom strong{font-weight:700;font-size:13px}.intro-bottom span{font-size:11px;color:#80766d;max-width:230px}.capabilities{display:grid;grid-template-columns:1fr 1fr;gap:38px 46px;padding-top:10px}.capability{border-top:1px solid var(--line);padding-top:23px;min-height:140px}.capability-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:26px}.capability-no{font-family:"Cormorant Garamond";font-size:28px;color:#ad8c6d}.capability-icon{height:29px;width:29px;color:#8f755f;stroke-width:1}.capability h3{font:600 16px/1.5 Manrope,sans-serif;max-width:210px;margin:0}.capability p{font-size:11px;color:#807268;margin:6px 0 0}
.portfolio{background:#1a1713;color:#f4ecdf;padding:114px 0 125px;overflow:hidden}.portfolio .intro-title{max-width:770px}.portfolio .intro-title em{color:#bea081}.portfolio-top{display:flex;justify-content:space-between;align-items:end;gap:30px}.portfolio-controls{display:flex;gap:9px;padding-bottom:5px}.icon-btn{width:49px;height:49px;border:1px solid rgba(242,232,216,.5);background:transparent;color:#f4ecdf;font-size:25px;transition:background .25s}.icon-btn:hover{background:rgba(255,255,255,.15)}.portfolio-slider{display:flex;gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;overscroll-behavior-inline:contain;padding:30px max(60px,calc((100vw - 1470px)/2)) 0;scroll-padding-inline:60px}.portfolio-slider::-webkit-scrollbar{display:none}.project{flex:0 0 clamp(280px,29vw,454px);height:520px;scroll-snap-align:start;position:relative;overflow:hidden;cursor:pointer;display:block;background:#473c31;border:0;color:white;text-align:left;padding:0}.project:before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(0,0,0,0) 42%,rgba(0,0,0,.84) 100%);pointer-events:none}.project-image{position:absolute;inset:0;background-position:center;background-size:cover;transition:transform .9s var(--ease),filter .5s;filter:saturate(.86)}.project:hover .project-image{transform:scale(1.085);filter:saturate(1.08)}.project-info{position:absolute;left:30px;right:29px;bottom:31px;z-index:2}.project-index{font-size:10px;letter-spacing:.2em;color:#dfc7ae}.project h3{font-family:"Cormorant Garamond",Georgia,serif;font-size:45px;line-height:1.02;letter-spacing:-.025em;margin:11px 0}.project-info p{font-size:11px;color:#e2d1bd;margin:0}.project-go{position:absolute;right:28px;bottom:34px;border:1px solid rgba(255,255,255,.6);width:39px;height:39px;border-radius:50%;z-index:3;display:flex;align-items:center;justify-content:center;transition:background .25s;color:white}.project:hover .project-go{background:rgba(255,255,255,.22)}.portfolio-note{font-size:11px;opacity:.6;margin-top:24px}
.formats{background:var(--cream);padding:100px 0 108px}.formats-grid{display:grid;grid-template-columns:.84fr 1.16fr;gap:11%;align-items:start}.formats .description{max-width:360px}.format-list{border-top:1px solid var(--line)}.format-row{padding:20px 1px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:62px 1fr 29px;align-items:center;gap:14px;transition:padding .3s,background .3s}.format-row:hover{padding-left:15px;background:rgba(255,255,255,.31)}.format-row .num{font-size:10px;color:#958371}.format-row strong{font-size:clamp(19px,2.2vw,29px);line-height:1.2;font-weight:500;letter-spacing:-.04em}.format-row .plus{font-family:Georgia,serif;font-size:22px;color:#a78a70}
.expert{background:var(--cream2);padding:125px 0}.expert-grid{display:grid;grid-template-columns:1fr 1fr;gap:10%;align-items:center}.expert-visual{position:relative;min-height:650px;background:#2b241d;overflow:hidden}.expert-visual:before{content:"";position:absolute;inset:0;background-image:linear-gradient(0deg,rgba(13,12,10,.9) 0%,rgba(13,12,10,.07) 65%),url('assets/interior.webp');background-size:cover;background-position:center}.expert-card-text{position:absolute;left:40px;right:30px;bottom:40px;color:#f4eadc}.expert-card-text .label{font-size:9px;color:#e7caa8}.expert-card-text h3{font-size:66px;line-height:.87;letter-spacing:-.035em;margin:20px 0 12px}.expert-card-text span{font-size:12px;opacity:.8}.expert-stamp{position:absolute;top:25px;right:25px;border:1px solid rgba(255,255,255,.65);border-radius:50%;width:100px;height:100px;color:white;display:flex;align-items:center;justify-content:center;text-transform:uppercase;text-align:center;font-size:8px;line-height:2;letter-spacing:.1em;transform:rotate(10deg)}.expert-copy .intro-title{font-size:clamp(55px,5.6vw,96px)}.expert-copy .description{max-width:520px}.credentials{list-style:none;padding:0;margin:35px 0 37px;border-top:1px solid var(--line)}.credentials li{padding:15px 0;border-bottom:1px solid var(--line);display:flex;gap:26px;align-items:center;font-size:13px;font-weight:600}.credentials li span{font-family:Georgia,serif;font-size:18px;color:#9d816a}
.process{background:#25211c;color:#f2e9dc;padding:118px 0 128px;overflow:hidden}.process .section-heading{align-items:start}.process .description{color:#c6b8a6}.process .intro-title em{color:#b89a7b}.step-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border-top:1px solid rgba(255,255,255,.24);margin-top:60px}.step{padding:36px 31px 0 31px;border-left:1px solid rgba(255,255,255,.2);min-height:252px}.step:first-child{padding-left:0;border-left:0}.step-no{font-family:"Cormorant Garamond",Georgia,serif;font-size:57px;line-height:1;color:#bd9e7f;margin:0 0 44px}.step h3{font:600 17px/1.4 Manrope,sans-serif;margin:0 0 11px}.step p{font-size:11px;color:#bcae9e;line-height:1.8;margin:0;max-width:220px}.process-footer{display:flex;justify-content:space-between;align-items:center;gap:30px;margin-top:65px;border-top:1px solid rgba(255,255,255,.22);padding-top:26px}.process-footer p{max-width:550px;margin:0;color:#dacdbc;font-size:12px}
.pricing{background:var(--cream2);padding:123px 0 132px}.pricing-heading{display:grid;grid-template-columns:1fr 1fr;gap:9%;margin-bottom:45px}.pricing-heading .description{align-self:end;max-width:480px}.pricing-panel{border:1px solid #d6c9b9;background:#eee7dc;display:grid;grid-template-columns:.9fr 1.1fr}.pricing-selector{padding:50px;border-right:1px solid #d6c9b9}.pricing-selector h3{font-size:33px;margin:0 0 8px;line-height:1.1}.pricing-selector p{font-size:11px;color:#766a5f;margin:0 0 31px}.size-options{display:grid;grid-template-columns:repeat(2,1fr);gap:9px}.size-option{padding:17px 12px;background:transparent;border:1px solid #cfc1af;text-align:center;font-size:13px;color:#45382d;transition:all .2s}.size-option:hover,.size-option.active{background:#241e19;border-color:#241e19;color:#f7f0e6}.pricing-output{padding:48px 49px 49px}.output-head{font-size:10px;letter-spacing:.22em;color:#78695a;text-transform:uppercase;display:flex;justify-content:space-between;align-items:center;gap:15px}.output-badge{background:#e0d3c5;padding:5px 10px;font-size:9px;letter-spacing:.05em;text-transform:none}.large-price{font-family:"Cormorant Garamond";font-size:clamp(72px,8vw,124px);line-height:1;letter-spacing:-.065em;margin:24px 0 10px}.price-text{font-size:12px;color:#6c5f51}.budget-breakdown{border-top:1px solid #c8b9a6;display:flex;justify-content:space-between;align-items:center;gap:20px;margin-top:32px;padding-top:24px}.budget-breakdown strong{font-size:21px;letter-spacing:-.035em;white-space:nowrap}.budget-breakdown span{display:block;font-size:11px;color:#756759;line-height:1.5}.pricing-disclaimer{display:flex;gap:16px;align-items:start;margin-top:23px;font-size:11px;color:#837469;max-width:900px}.pricing-disclaimer span:first-child{font-size:17px;color:#9e8065}
.faq{background:#f0e9df;padding:120px 0}.faq-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:12%}.faq .intro-title{margin-bottom:35px}.faq-list{border-top:1px solid var(--line)}details{border-bottom:1px solid var(--line);padding:21px 0}summary{cursor:pointer;list-style:none;display:flex;align-items:center;justify-content:space-between;gap:20px;font-size:15px;line-height:1.5;font-weight:700}summary::-webkit-details-marker{display:none}summary:after{content:"+";font:normal 27px/1 Georgia,serif;color:#997e65;transition:transform .2s}details[open] summary:after{transform:rotate(45deg)}details p{font-size:12px;color:#766b60;line-height:1.85;max-width:550px;margin:15px 35px 6px 0}
.contact{background:#171410;color:#f3eade;position:relative;padding:120px 0 114px;overflow:hidden}.contact:before{content:"";position:absolute;inset:0;background:url('assets/arch.webp') center/cover no-repeat;opacity:.12;mix-blend-mode:screen;pointer-events:none}.contact-grid{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:11%;align-items:start}.contact .intro-title{font-size:clamp(64px,7vw,123px);margin-bottom:35px}.contact .intro-title em{color:#c5a88b}.contact-lead{font-size:14px;color:#cfc0af;max-width:430px;line-height:1.9}.contact-meta{margin-top:105px;display:flex;gap:30px;align-items:center;color:#cfb9a2;font-size:10px;letter-spacing:.13em;text-transform:uppercase}.contact-meta:before{content:"";width:50px;height:1px;background:#9a7b60}.form-box{background:#f3ece1;color:#251f19;padding:43px}.form-box h3{font-size:44px;line-height:1;margin:0 0 9px}.form-sub{color:#7f7061;font-size:11px;line-height:1.7;margin:0 0 28px}.field-row{display:grid;grid-template-columns:1fr 1fr;gap:13px}.field{display:flex;flex-direction:column;gap:8px;margin-bottom:17px}.field label{font-size:10px;color:#66594b;font-weight:700}.field input,.field select,.field textarea{width:100%;border:1px solid #cabbab;border-radius:0;background:transparent;color:#2c251f;padding:13px 13px;font-size:12px;min-height:48px;outline:none;transition:border-color .2s}.field input:focus,.field select:focus,.field textarea:focus{border-color:#6d5340}.field textarea{min-height:90px;resize:vertical}.form-submit{width:100%;margin-top:3px}.form-note{font-size:10px;color:#89796a;margin:13px 0 0;line-height:1.6}.form-status{display:none;background:#e3d5c5;padding:15px;font-size:12px;margin-top:15px;line-height:1.7}.form-status.show{display:block}.copy-btn{display:none;margin-top:12px;border:1px solid #473b2f;background:transparent;color:#34271e;font-weight:700;font-size:12px;padding:10px 16px}.copy-btn.show{display:inline-flex}
.footer{background:#100f0d;color:#dfd3c6;padding:43px 0 25px}.footer-top{display:flex;align-items:start;justify-content:space-between;gap:30px;padding-bottom:40px}.footer .brand{color:#f4eadd}.footer-links{display:flex;gap:26px;flex-wrap:wrap}.footer-links a{font-size:11px;color:#bcae9f}.footer-links a:hover{color:white}.footer-bottom{border-top:1px solid rgba(255,255,255,.14);padding-top:20px;display:flex;justify-content:space-between;align-items:center;gap:20px;color:#897f75;font-size:10px}.footer-bottom span{max-width:450px}.floating-to-top{position:fixed;bottom:24px;right:24px;width:44px;height:44px;background:#f1e5d5;color:#231c17;border:0;z-index:50;box-shadow:0 8px 30px #0003;opacity:0;pointer-events:none;transform:translateY(10px);transition:opacity .3s,transform .3s}.floating-to-top.visible{opacity:1;transform:translateY(0);pointer-events:auto}
.modal{position:fixed;inset:0;display:none;align-items:center;justify-content:center;z-index:200;padding:20px;background:rgba(14,12,10,.85);backdrop-filter:blur(8px)}.modal.open{display:flex}.modal-inner{width:min(95vw,900px);position:relative;background:#f3ede3;color:#211b16;display:grid;grid-template-columns:1fr 1fr;min-height:460px;max-height:85vh;overflow:auto}.modal-visual{min-height:360px;background-size:cover;background-position:center}.modal-body{padding:48px 45px}.modal-body h3{font-size:61px;line-height:.94;letter-spacing:-.045em;margin:18px 0 25px}.modal-body p{font-size:13px;color:#675a4f;line-height:1.9}.modal-close{position:absolute;top:12px;right:12px;width:42px;height:42px;background:#1e1915;border:0;color:white;z-index:2;font-size:24px}.modal-tag{font-size:10px;letter-spacing:.17em;text-transform:uppercase;color:#96765a}
.reveal{opacity:0;transform:translateY(30px);transition:opacity .85s var(--ease),transform .85s var(--ease)}.reveal.in-view{opacity:1;transform:translateY(0)}@keyframes rise{from{opacity:0;transform:translateY(32px)}to{opacity:1;transform:translateY(0)}}@keyframes heroZoom{from{opacity:.6;transform:scale(1.15)}to{opacity:1;transform:scale(1.045)}}
@media(min-width:1600px){.portfolio-slider{padding-left:calc((100vw - 1470px)/2);padding-right:calc((100vw - 1470px)/2)}}
@media(max-width:1120px){:root{--container:min(100% - 70px,1400px)}.nav-links{gap:16px}.nav-links a{font-size:10px}.brand{min-width:0}.header-cta{padding:11px 14px;font-size:10px}.hero h1{font-size:clamp(75px,10vw,130px)}.intro-grid,.expert-grid{gap:6%}.expert-visual{min-height:570px}.project{height:480px}.portfolio-slider{padding-left:35px;padding-right:35px;scroll-padding-inline:35px}}
@media(max-width:860px){:root{--container:calc(100% - 46px)}.site-header{height:80px}.site-header.is-scrolled{height:70px}.nav-links,.header-cta{display:none}.menu-toggle{display:flex}.mobile-menu{display:flex;position:fixed;top:0;right:0;width:min(100vw,410px);height:100dvh;z-index:150;background:#1c1713;color:#f3e8d9;transform:translateX(103%);transition:transform .5s var(--ease);padding:105px 29px 35px;flex-direction:column;box-shadow:-20px 0 60px rgba(0,0,0,.3)}.mobile-menu.open{transform:translateX(0)}.mobile-menu a:not(.button){font:normal 42px/1.07 "Cormorant Garamond",Georgia,serif;padding:12px 0;border-bottom:1px solid rgba(255,255,255,.16)}.mobile-menu .button{margin-top:35px}.menu-close{position:absolute;top:25px;right:23px;background:transparent;color:white;border:1px solid #605249;font-size:26px;width:42px;height:42px}.hero{min-height:730px;height:95svh}.hero-photo{background-position:60% center}.hero:before{background:linear-gradient(90deg,rgba(12,11,10,.85),rgba(12,11,10,.22)),linear-gradient(0deg,rgba(9,9,8,.85),transparent 48%,rgba(9,9,8,.2))}.hero h1{font-size:clamp(78px,12vw,120px)}.hero-scroll{display:none}.hero-content{padding-bottom:140px}.stat{padding:0 17px}.stats-grid{grid-template-columns:repeat(4,1fr)}.stat-number{font-size:33px}.stat:last-child .stat-number{font-size:27px}.section{padding:84px 0}.intro{padding:95px 0}.intro-grid,.expert-grid,.formats-grid,.faq-grid,.contact-grid,.pricing-heading{grid-template-columns:1fr;gap:50px}.intro-grid .capabilities{margin-top:5px}.capability{min-height:110px}.section-heading{align-items:start;flex-direction:column;gap:20px}.expert{padding:90px 0}.expert-visual{min-height:550px}.expert-copy .intro-title{font-size:75px}.formats .description{max-width:550px}.process .step-grid{grid-template-columns:repeat(2,1fr);row-gap:45px}.step:nth-child(3){padding-left:0;border-left:0}.pricing-panel{grid-template-columns:1fr}.pricing-selector{border-right:0;border-bottom:1px solid #d6c9b9;padding:34px}.pricing-output{padding:37px 34px}.contact-meta{margin-top:30px}.contact .intro-title{font-size:94px}.portfolio{padding:90px 0}.portfolio-slider{padding-left:23px;scroll-padding-inline:23px}.project{flex-basis:43vw;height:460px}.footer-top{flex-direction:column;gap:29px}}
@media(max-width:560px){:root{--container:calc(100% - 38px)}body{font-size:13px}.brand{gap:10px}.brand svg{width:29px;height:35px}.brand-type strong{font-size:11px;letter-spacing:.18em}.brand-type small{font-size:5.3px;letter-spacing:.25em;margin-top:6px}.hero{height:100svh;min-height:640px;max-height:850px}.hero-photo{background-position:62% 45%}.hero:before{background:linear-gradient(90deg,rgba(11,10,9,.78),rgba(11,10,9,.3)),linear-gradient(0deg,rgba(10,9,8,.88) 0%,transparent 57%,rgba(10,9,8,.25) 100%)}.hero-content{padding-top:8px;padding-bottom:148px;justify-content:center}.hero .hero-label{font-size:8px;letter-spacing:.16em;margin-bottom:22px}.hero h1{font-size:clamp(72px,15.7vw,108px);line-height:.83;letter-spacing:-.065em;margin-bottom:24px}.hero-copy{max-width:345px;font-size:12px;line-height:1.85;margin-bottom:25px}.hero-actions{gap:10px}.hero-actions .button{min-height:50px;padding:0 17px;font-size:10px;gap:13px}.hero-actions .text-link{font-size:10px;letter-spacing:0;padding-bottom:5px;gap:8px}.hero-stats{background:rgba(17,15,13,.6)}.stats-grid{grid-template-columns:1fr 1fr;padding-top:18px;padding-bottom:20px;row-gap:14px}.stat{padding:0 10px;border-left:1px solid rgba(255,248,235,.2)}.stat:nth-child(odd){padding-left:0;border-left:0}.stat-number{font-size:32px}.stat:last-child .stat-number{font-size:28px}.stat-caption{font-size:9px}.intro,.expert,.formats,.process,.pricing,.faq,.contact{padding:77px 0}.intro-title{font-size:57px}.big-title{font-size:64px}.intro-grid,.expert-grid,.formats-grid,.faq-grid,.contact-grid{gap:36px}.description{font-size:12px;line-height:1.9}.intro-bottom{margin-top:30px;flex-direction:column;align-items:start;gap:7px}.capabilities{gap:18px 15px}.capability{padding-top:17px;min-height:130px}.capability-top{margin-bottom:16px}.capability h3{font-size:12px}.capability p{font-size:10px}.portfolio{padding:75px 0}.portfolio .intro-title{font-size:61px}.portfolio-top{align-items:end}.portfolio-controls{gap:7px}.icon-btn{height:39px;width:39px}.project{flex-basis:82vw;height:460px}.project-info{left:22px;bottom:24px}.project h3{font-size:45px}.project-info p{font-size:10px;max-width:190px}.project-go{right:22px;bottom:26px}.formats .intro-title{margin-top:15px}.format-row{grid-template-columns:28px 1fr 20px;padding:17px 0}.format-row strong{font-size:23px}.expert-visual{min-height:460px}.expert-card-text{left:25px;bottom:28px}.expert-card-text h3{font-size:58px}.expert-stamp{width:76px;height:76px;font-size:6px}.expert-copy .intro-title{font-size:63px}.credentials{margin-top:20px}.credentials li{font-size:12px;gap:17px}.process .section-heading{gap:20px}.process .step-grid{margin-top:30px;row-gap:27px}.step{padding:26px 13px 0 17px;min-height:240px}.step:nth-child(odd){padding-left:0;border-left:0}.step-no{font-size:48px;margin-bottom:31px}.step h3{font-size:13px}.step p{font-size:10px}.process-footer{margin-top:33px;align-items:start;flex-direction:column}.pricing-heading{gap:5px;margin-bottom:25px}.pricing-selector{padding:25px 18px}.pricing-selector h3{font-size:31px}.size-options{gap:7px}.size-option{padding:12px 7px;font-size:11px}.pricing-output{padding:30px 18px}.output-head{font-size:9px}.large-price{font-size:80px}.budget-breakdown strong{font-size:18px}.budget-breakdown span{font-size:10px}.faq .intro-title{margin-bottom:8px}summary{font-size:13px}details p{font-size:11px}.contact .intro-title{font-size:77px}.contact-lead{font-size:12px}.contact-meta{margin-top:25px}.form-box{padding:24px 19px}.form-box h3{font-size:41px}.field-row{grid-template-columns:1fr;gap:0}.form-note{font-size:9px}.footer-top{gap:25px}.footer-links{gap:12px 18px}.footer-links a{font-size:10px}.footer-bottom{flex-direction:column;align-items:start}.modal-inner{display:block;max-height:90dvh}.modal-visual{height:220px;min-height:220px}.modal-body{padding:26px}.modal-body h3{font-size:52px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{transition-duration:.01ms!important;animation-duration:.01ms!important}.reveal{opacity:1;transform:none}}

/* v2 / real photography editorial additions */
.hero-proof{position:absolute;top:27%;right:1%;width:clamp(214px,21vw,320px);display:block;color:#f7f0e3;background:#18140f;border:1px solid rgba(250,233,208,.23);box-shadow:0 24px 70px rgba(0,0,0,.36);transform:rotate(2deg);transition:transform .5s var(--ease),box-shadow .5s;animation:rise 1.1s .75s both;z-index:2}
.hero-proof:hover{transform:rotate(0deg) translateY(-8px);box-shadow:0 30px 80px rgba(0,0,0,.5)}
.hero-proof-image{height:clamp(205px,24vw,365px);overflow:hidden;display:block}
.hero-proof-image img{object-fit:cover;object-position:center top;filter:saturate(.8)}
.hero-proof-caption{display:flex;flex-direction:column;gap:4px;padding:15px 18px 18px;background:#18140f}
.hero-proof-top{font-size:9px;letter-spacing:.18em;color:#d8b899}
.hero-proof-caption strong{font:500 35px/.95 'Cormorant Garamond',Georgia,serif}
.hero-proof-caption small{font-size:10px;color:#e4d5be}
.hero h1{max-width:830px}
.hero-copy{max-width:425px}
.expert-visual{background:radial-gradient(ellipse at 50% 40%,#716051 0%,#393027 50%,#191713 100%);min-height:740px}
.expert-visual:before{background-image:linear-gradient(0deg,rgba(16,14,12,.84) 0%,transparent 43%),radial-gradient(circle at 50% 36%,rgba(199,166,123,.16),transparent 58%);z-index:1}
.expert-portrait{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;object-position:center bottom;filter:saturate(.93);z-index:0}
.expert-card-text{z-index:2;bottom:24px}
.expert-stamp{z-index:3}
.expert-card-text h3{font-size:76px}
.kitchen-story{background:#f6f1e9;color:var(--ink);padding:112px 0 110px}
.kitchen-story-head{display:flex;align-items:end;justify-content:space-between;gap:6%;margin-bottom:42px}
.kitchen-story-head .intro-title{margin-bottom:0;max-width:700px}
.kitchen-story-head .description{max-width:400px}
.kitchen-pair{display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:start}
.kitchen-shot{height:560px;position:relative;overflow:hidden;background:#2e2924}
.kitchen-shot img{transition:transform .85s var(--ease);object-position:center}
.kitchen-shot:hover img{transform:scale(1.035)}
.kitchen-shot:after{position:absolute;inset:45% 0 0;content:'';background:linear-gradient(0deg,rgba(6,5,4,.75),transparent);pointer-events:none}
.kitchen-shot-lower{margin-top:88px}
.kitchen-shot figcaption{position:absolute;bottom:26px;left:28px;color:white;z-index:2;display:flex;flex-direction:column;gap:6px}
.kitchen-shot figcaption span{font-size:10px;letter-spacing:.22em;color:#e2c4a2}
.kitchen-shot figcaption strong{font:500 42px/.95 'Cormorant Garamond',Georgia,serif}
.kitchen-foot,.food-bottom{margin-top:35px;display:flex;justify-content:space-between;align-items:center;gap:30px}
.kitchen-foot > span,.food-bottom > span{font-size:11px;color:#82776e}
.food-story{background:#201b17;padding:115px 0;color:#f5ecdf}
.food-heading{max-width:850px;margin-bottom:40px}
.food-heading .intro-title em{color:#d2ad85}
.food-heading p{font-size:14px;max-width:500px;color:#c5b8a6}
.food-mosaic{display:grid;grid-template-columns:1.15fr .85fr .85fr;grid-template-rows:310px 285px;gap:14px}
.food-tile{position:relative;overflow:hidden;background:#3a332c}
.food-tile:after{position:absolute;inset:35% 0 0;content:'';background:linear-gradient(0deg,rgba(9,8,6,.8),transparent)}
.food-tile img{transition:transform 1s var(--ease)}
.food-tile:hover img{transform:scale(1.06)}
.food-tile figcaption{position:absolute;bottom:16px;left:20px;z-index:2;font-size:11px;letter-spacing:.08em;color:#f7eee1}
.food-tile-a{grid-row:span 2}.food-tile-b{grid-column:span 2}.food-tile-c{grid-column:span 1}.food-tile-d{grid-column:span 1}
.food-bottom > span{color:#bbaa96}.food-bottom .text-link{color:#f4e3c9}
/* disabled display of stale external image stand-ins */
@media (max-width:1080px){.hero-proof{right:1.5%;top:34%;width:240px}.hero h1{font-size:clamp(65px,8.9vw,100px);max-width:700px}.hero-copy{max-width:380px}.kitchen-shot{height:460px}.expert-visual{min-height:600px}}
@media (max-width:760px){.hero-proof{display:none}.kitchen-story{padding:76px 0 78px}.kitchen-story-head{display:block}.kitchen-story-head .description{margin-top:20px}.kitchen-pair{grid-template-columns:1fr;gap:18px}.kitchen-shot{height:400px}.kitchen-shot-lower{margin-top:0}.kitchen-foot,.food-bottom{align-items:flex-start;flex-direction:column;gap:16px}.food-story{padding:78px 0}.food-mosaic{grid-template-columns:1fr 1fr;grid-template-rows:340px 210px 210px;gap:9px}.food-tile-a{grid-row:span 1;grid-column:span 2}.food-tile-b{grid-column:span 2}.food-tile-c{grid-column:span 1}.food-tile-d{grid-column:span 1}.expert-visual{min-height:620px}.expert-card-text{left:24px}.expert-card-text h3{font-size:60px}}
@media (max-width:430px){.expert-visual{min-height:545px}.food-mosaic{grid-template-rows:300px 190px 190px}.kitchen-shot{height:330px}.kitchen-shot figcaption strong{font-size:35px}.food-tile figcaption{font-size:10px;left:10px;bottom:10px}}
@media (prefers-reduced-motion:reduce){.hero-proof,.food-tile img,.kitchen-shot img{animation:none!important;transition:none!important}}

/* VERSION 3: refined identity and architectural hero */
:root{--ink:#201a16;--black:#13110f;--gold:#C4A17E;--cream:#ede5d9;--cream2:#f7f2eb}
.brand{gap:13px}.brand .brand-symbol{width:40px;height:46px;color:#dfb78f;filter:drop-shadow(0 0 9px rgba(223,183,143,.08))}.brand-type strong{font-family:Manrope,Arial,sans-serif;letter-spacing:.205em;font-size:14px;font-weight:700}.brand-type small{font-size:7.2px;letter-spacing:.28em;margin-top:7px}
.hero-v3{min-height:780px;height:min(980px,100svh);background:#17120e;isolation:isolate}
.hero-v3 .hero-photo{left:45%;right:0;top:0;bottom:0;background-image:url('assets/greystone.webp');background-position:center 48%;background-size:cover;transform:scale(1.07);animation:heroZoom 1.4s var(--ease) both;z-index:-4}
.hero-v3:before{z-index:-2;background:linear-gradient(90deg,#17120f 0%,#17120f 35%,rgba(23,18,15,.91) 44%,rgba(23,18,15,.16) 77%,rgba(23,18,15,.18) 100%),linear-gradient(0deg,rgba(12,9,7,.94) 0%,transparent 26%,rgba(12,9,7,.22) 100%)}
.hero-v3:after{z-index:-1;background:linear-gradient(180deg,rgba(11,9,7,.35),transparent 16%,transparent 79%,rgba(11,9,7,.13));}
.hero-v3 .hero-content{padding-top:105px;padding-bottom:135px;justify-content:center;align-items:flex-start}
.hero-v3 .hero-label{font-size:10px;letter-spacing:.22em;color:#d9b998;margin-bottom:27px}
.hero-v3 h1{font-size:clamp(69px,8.1vw,142px);line-height:.84;letter-spacing:-.069em;max-width:1000px;color:#f7efe3;margin:0 0 38px;text-wrap:balance}
.hero-v3 h1 em{font-weight:400;color:#ddb994}.hero-period{color:#c79e75}
.hero-v3 .hero-copy{max-width:470px;color:#e5d8ca;font-size:14px;line-height:1.85;margin-bottom:31px}
.hero-v3 .hero-actions{gap:24px}.hero-primary{background:#e9d9c6;color:#201910;border-radius:0;padding-inline:27px;min-height:59px;box-shadow:0 15px 35px #0003}.hero-primary:hover{background:#fff4e4}
.hero-discover{display:inline-flex;align-items:center;gap:13px;color:#e5d4c1;font-size:11px;line-height:1.45;font-weight:600;transition:color .2s}.hero-discover:hover{color:white}.hero-play{display:grid;place-items:center;width:49px;height:49px;border:1px solid #a69584;border-radius:50%;font-size:22px;transition:transform .3s}.hero-discover:hover .hero-play{transform:rotate(45deg)}
.hero-v3 .hero-scroll{right:5px;bottom:185px}.hero-v3 .hero-stats{background:rgba(19,15,13,.84);backdrop-filter:blur(12px)}.hero-v3 .stats-grid{padding-top:24px;padding-bottom:25px}.hero-v3 .stat-number{font-size:clamp(40px,3.3vw,56px);font-weight:400}.hero-v3 .stat:last-child .stat-number{font-size:clamp(36px,3vw,50px)}.stat-accent{color:#c6a17d}.stat-caption{font-size:10.5px;letter-spacing:.02em}
.hero-number{position:absolute;right:4.3%;top:155px;z-index:2;color:rgba(255,248,239,.88);font-size:12px;letter-spacing:.2em;display:flex;gap:18px;align-items:center}.hero-number span{font-size:8px;opacity:.7}
.hero-feature{position:absolute;right:0;bottom:170px;width:320px;padding:22px 23px 20px;background:rgba(15,12,10,.77);border:1px solid rgba(244,232,216,.26);backdrop-filter:blur(15px);color:#fff2e3;transition:background .25s,transform .25s}.hero-feature:hover{background:rgba(15,12,10,.91);transform:translateY(-4px)}.hero-feature-kicker{font-size:9px;color:#d1b395;letter-spacing:.18em;margin-bottom:7px}.hero-feature-row{display:flex;justify-content:space-between;align-items:center;gap:20px}.hero-feature strong{font:400 40px/.95 'Cormorant Garamond',Georgia,serif}.hero-feature-row span{font-size:24px}.hero-feature small{font-size:10px;color:#d9c7b3;display:block;margin-top:8px}
.intro .intro-title{max-width:690px}.intro-copy .description{max-width:510px}
.brand .brand-symbol:focus{outline:2px solid #fff}
.project:focus-visible,.format-row:focus-visible,.button:focus-visible,.hero-feature:focus-visible,.hero-discover:focus-visible{outline:3px solid #d8b38d;outline-offset:3px}
.format-row{color:inherit;text-decoration:none}.format-row:hover strong{color:#8b694b}.format-row .plus{transition:transform .2s}.format-row:hover .plus{transform:translate(3px,-3px)}
.manifesto{background:#d0b89d;color:#211a14;padding:92px 0 88px;overflow:hidden}.manifesto-grid{display:grid;grid-template-columns:150px 1fr 260px;gap:36px;align-items:end}.manifesto-index{font-size:10px;letter-spacing:.2em;align-self:start;margin-top:12px}.manifesto h2{font:400 clamp(43px,5.2vw,81px)/.99 'Cormorant Garamond',Georgia,serif;letter-spacing:-.041em;margin:0}.manifesto h2 em{color:#7c5338;font-weight:400}.manifesto h2 span{border-bottom:1px solid #674d3d}.manifesto-action p{font-size:12px;line-height:1.8;color:#493b30}.manifesto-action .text-link{margin-top:15px}
.mobile-fixed-cta{display:none}.lead-area-note{font-size:10px;color:#887668}
/* Avoid blank sections for visitors with JS disabled or delayed loading */
@media(prefers-reduced-motion: reduce){.hero-v3 .hero-photo{transform:none;animation:none!important}}
@media(max-width:1120px){.hero-feature{width:250px}.hero-v3 h1{font-size:clamp(68px,8.9vw,110px)}.manifesto-grid{grid-template-columns:100px 1fr;gap:20px}.manifesto-action{grid-column:2}}
@media(max-width:860px){.hero-v3{height:92svh;min-height:780px}.hero-v3 .hero-photo{left:25%;background-position:49% center}.hero-v3:before{background:linear-gradient(90deg,rgba(15,12,10,.91) 0%,rgba(15,12,10,.72) 48%,rgba(15,12,10,.2) 100%),linear-gradient(0deg,#16110f 0%,transparent 45%,rgba(10,8,6,.38))}.hero-v3 h1{font-size:clamp(75px,11vw,112px);max-width:700px}.hero-feature{bottom:175px;right:0}.hero-number{right:6%;top:120px}.manifesto{padding:70px 0}.manifesto-grid{grid-template-columns:1fr;gap:15px}.manifesto-action{grid-column:auto;max-width:500px}}
@media(max-width:760px){.hero-v3{height:auto;min-height:865px}.hero-v3 .hero-photo{left:0;background-position:55% center;opacity:.53}.hero-v3:before{background:linear-gradient(90deg,rgba(16,12,10,.86),rgba(16,12,10,.53)),linear-gradient(0deg,#16110f 0%,rgba(16,12,10,.05) 55%,rgba(13,9,7,.25))}.hero-v3 .hero-content{padding-top:127px;padding-bottom:231px;justify-content:flex-start;min-height:865px}.hero-v3 .hero-label{font-size:9px;margin-bottom:26px}.hero-v3 h1{font-size:clamp(67px,12vw,96px);line-height:.88;margin-bottom:27px}.hero-v3 .hero-copy{font-size:13px;max-width:420px;margin-bottom:23px}.hero-feature{bottom:146px;right:0;left:0;width:100%;padding:16px 18px;max-width:380px}.hero-feature strong{font-size:32px}.hero-number{display:none}.hero-v3 .hero-stats{background:rgba(15,12,10,.92)}.hero-v3 .stats-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 12px;padding-top:21px;padding-bottom:21px}.hero-v3 .stat{border-left:0;padding:0}.hero-v3 .stat:nth-child(even){border-left:1px solid rgba(255,248,235,.25);padding-left:17px}.hero-v3 .stat-number,.hero-v3 .stat:last-child .stat-number{font-size:34px}.hero-v3 .stat-caption{font-size:9px}.mobile-fixed-cta{display:flex;align-items:center;justify-content:space-between;gap:20px;position:fixed;z-index:70;bottom:12px;left:14px;right:14px;background:#d2ad89;color:#1d1814;min-height:50px;padding:0 20px;font-size:12px;font-weight:800;box-shadow:0 10px 32px rgba(0,0,0,.28);border:1px solid #ead0ad}.mobile-fixed-cta span{font-size:23px}.footer{padding-bottom:100px}.floating-to-top{bottom:78px}.contact{padding-bottom:100px}}
@media(max-width:430px){.brand .brand-symbol{height:37px;width:33px}.brand-type strong{font-size:11px}.brand-type small{font-size:5.5px;letter-spacing:.21em}.hero-v3{min-height:865px}.hero-v3 .hero-content{min-height:865px}.hero-v3 h1{font-size:clamp(55px,12.3vw,72px)}.hero-v3 .hero-actions{gap:14px}.hero-primary{padding-inline:18px;font-size:11px}.hero-discover{font-size:10px}.hero-play{width:39px;height:39px}.hero-feature{bottom:149px}.hero-v3 .stat-number,.hero-v3 .stat:last-child .stat-number{font-size:29px}.manifesto h2{font-size:50px}}
</style>
<meta content="GASTRO ATELIER — від ідеї до першого гостя" property="og:title"/><meta content="Бюро запуску закладів під ключ. Реальні проєкти, меню, технології, команда й підтримка після відкриття." property="og:description"/><meta content="website" property="og:type"/><style>
/* Brand identity system: production logo artwork embedded in real content */
.site-header .brand,.footer .brand{min-width:0;display:flex;align-items:center;flex:none}
.brand-artwork{display:block;width:252px;height:72px;object-fit:contain;object-position:left center;filter:drop-shadow(0 2px 8px rgba(0,0,0,.22))}
.site-header.is-scrolled .brand-artwork{height:62px}
.footer .brand-artwork{width:315px;height:98px}
.hero-brand-plate{position:absolute;right:0;bottom:162px;width:min(32vw,400px);padding:8px 12px;background:rgba(10,9,8,.87);border:1px solid rgba(238,206,162,.36);box-shadow:0 14px 65px rgba(0,0,0,.46);backdrop-filter:blur(18px);transform:translateY(0);transition:transform .3s ease,box-shadow .3s ease;}
.hero-brand-plate:hover{transform:translateY(-5px);box-shadow:0 18px 70px rgba(0,0,0,.58)}
.hero-brand-plate .hero-logo-image{width:100%;height:auto;display:block;object-fit:contain}
.hero-brand-label{font-size:9px;letter-spacing:.25em;color:#e5c8aa;padding:6px 0 0;text-align:center}
.hero-brand-plate:after{content:'';pointer-events:none;position:absolute;inset:-1px;border:1px solid rgba(244,171,100,.1)}
.intro-brand-seal{display:flex;justify-content:flex-start;margin-top:30px;gap:12px;align-items:center}
.intro-brand-seal img{height:76px;width:76px;object-fit:cover;border:1px solid rgba(196,161,126,.4);border-radius:14px;box-shadow:0 12px 30px rgba(30,20,15,.12)}
.intro-brand-seal div{display:flex;flex-direction:column;font-size:11px;line-height:1.7;text-transform:uppercase;letter-spacing:.1em;color:#8d7260}
.intro-brand-seal strong{font-size:12px;color:#30251d;letter-spacing:.12em}
.footer{position:relative}
.footer .brand{width:auto}
@media(max-width:1230px){.brand-artwork{width:212px;height:70px}.nav-links{gap:12px!important}}
@media(max-width:1050px){.hero-brand-plate{width:300px;right:0;bottom:153px}.hero-brand-label{font-size:8px}}
@media(max-width:860px){.brand-artwork{width:245px;height:66px}.hero-brand-plate{display:none}}
@media(max-width:560px){.brand-artwork{width:208px;height:62px}.site-header.is-scrolled .brand-artwork{height:58px}.footer .brand-artwork{width:235px;height:75px}.intro-brand-seal img{width:62px;height:62px}}
@media(max-width:370px){.brand-artwork{width:178px;height:58px}.site-header .header-inner{gap:10px}}
@media(prefers-reduced-motion:reduce){.hero-brand-plate{transition:none}}

/* ATELIER — fine-dining architectural editorial */
:root{--ink:#2b241c;--black:#17120f;--earth:#2e231d;--cream:#efe5d7;--cream2:#f8f2e8;--gold:#d6aa76;--line:rgba(65,47,32,.19)}
body.brand-atelier{background:#f8f2e8}
.brand-atelier .hero-v3{background:#17110f}
.brand-atelier .hero-v3:before{background:linear-gradient(90deg,#16110f 0%,#18120f 31%,rgba(24,18,15,.89) 44%,rgba(24,18,15,.12) 85%),linear-gradient(0deg,rgba(13,10,8,.92),transparent 27%)}
.brand-atelier .hero-label{color:#f0c793}
.brand-atelier .hero h1{font-size:clamp(78px,8.6vw,160px)}
.brand-atelier .hero h1 em{color:#e9bd87}
.brand-atelier .hero-period,.brand-atelier .stat-accent{color:#dba967}
.brand-atelier .hero-primary{background:#ead4b5;color:#29180e;box-shadow:0 7px 24px rgba(0,0,0,.2)}
.brand-atelier .hero-brand-plate{border-color:rgba(230,183,124,.4);background:rgba(12,10,9,.84)}
.brand-atelier .hero-stats{background:rgba(21,14,11,.79)}
.brand-atelier .site-header.is-scrolled{background:rgba(26,18,14,.96)}
.brand-atelier .manifesto{background:linear-gradient(110deg,#241810,#100e0b)}
.brand-atelier .footer{background:#17120f}
.brand-atelier .mobile-menu{background:#241912}
@media(max-width:560px){.brand-atelier .hero h1{font-size:clamp(72px,15.5vw,108px)}}
</style></head>
<body class="brand-atelier">
<div aria-hidden="true" class="progress" id="progress"></div>
<header class="site-header" id="siteHeader"><div class="header-inner">
<a aria-label="Gastro Atelier — на головну" class="brand" href="#top"><img alt="Gastro Atelier — студія ресторанних проєктів" class="brand-artwork" decoding="async" src="assets/brand-horizontal.webp"/></a>
<nav aria-label="Основна навігація" class="nav-links"><a href="#about">Про нас</a><a href="#services">Послуги</a><a href="#projects">Проєкти</a><a href="#kitchens">Процес запуску</a><a href="#process">Етапи</a><a href="#pricing">Вартість</a></nav>
<a class="header-cta" href="#contact">Обговорити проєкт   ↗</a>
<button aria-controls="mobileMenu" aria-expanded="false" aria-label="Відкрити меню" class="menu-toggle" id="menuToggle" type="button"><span class="menu-lines"><i></i><i></i><i></i></span></button>
</div></header>
<nav aria-hidden="true" aria-label="Мобільна навігація" class="mobile-menu" id="mobileMenu"><button aria-label="Закрити меню" class="menu-close" id="menuClose" type="button">×</button><a href="#about">Про нас</a><a href="#services">Послуги</a><a href="#projects">Проєкти</a><a href="#process">Етапи</a><a href="#pricing">Вартість</a><a class="button" href="#contact">Обговорити проєкт <span>↗</span></a></nav>
<main id="top">
<section aria-labelledby="hero-title" class="hero hero-v3">
<div aria-hidden="true" class="hero-photo"></div>
<div aria-hidden="true" class="hero-number">01 — 04 <span>РЕАЛЬНІ ПРОЄКТИ</span></div>
<div class="container hero-content">
<div class="label hero-label">РЕСТОРАННІ ПРОЄКТИ ПІД КЛЮЧ · УКРАЇНА</div>
<h1 id="hero-title">Від ідеї<br/>до <em>першого</em><br/>гостя<span class="hero-period">.</span></h1>
<p class="hero-copy">Створюємо ресторани, кав’ярні, паби та стрітфуд. Від концепції й прорахунків — до відкритих дверей та першого місяця роботи.</p>
<div class="hero-actions">
<a class="button hero-primary" href="#contact">Обговорити відкриття <span aria-hidden="true" class="display-arrow">↗</span></a>
<a class="hero-discover" href="#projects"><span aria-hidden="true" class="hero-play">↗</span><span>Дивитись наші<br/>проєкти</span></a>
</div>
<div aria-hidden="true" class="hero-scroll">Гортай донизу</div>
<div aria-label="Gastro Atelier — фірмовий логотип" class="hero-brand-plate"><img alt="Gastro Atelier — студія ресторанних проєктів" class="hero-logo-image" src="assets/brand-horizontal.webp"/><div class="hero-brand-label">СТУДІЯ · ДОСВІД · РЕАЛЬНІ ЗАКЛАДИ</div></div>
</div>
<div class="hero-stats"><div class="container stats-grid">
<div class="stat"><div class="stat-number">20<span class="stat-accent">+</span></div><div class="stat-caption">закладів у досвіді команди</div></div>
<div class="stat"><div class="stat-number">2012</div><div class="stat-caption">початок роботи у сфері</div></div>
<div class="stat"><div class="stat-number">1,5–3</div><div class="stat-caption">місяці — типовий запуск*</div></div>
<div class="stat"><div class="stat-number">UA <span class="stat-accent">↗</span></div><div class="stat-caption">працюємо по всій Україні</div></div>
</div></div>
</section>
<section class="intro" id="about"><div class="container intro-grid"><div class="intro-copy reveal"><div class="label">01 / Філософія</div><h2 class="intro-title">Сильний заклад<br/>починається <em>із системи.</em></h2><p class="description">Гарний інтер’єр приваблює. Продумана кухня, фінансова модель, команда та процеси дозволяють закладу працювати щодня. Ми допомагаємо зібрати всі ці частини в один діючий бізнес.</p><div class="intro-bottom"><strong>Повний цикл. Одна команда.</strong><span>Від концепції та фінансової моделі до першого дня роботи.</span></div><div aria-label="Фірмовий знак Gastro Atelier" class="intro-brand-seal"><img alt="Знак Gastro Atelier" loading="lazy" src="assets/brand-icon.webp"/><div><strong>Gastro Atelier</strong><span>Відкриття закладів під ключ</span></div></div></div><div class="capabilities reveal"><div class="capability"><div class="capability-top"><span class="capability-no">01</span><svg class="capability-icon" fill="none" stroke="currentColor" viewbox="0 0 32 32"><path d="m6 26 5-19 15 15-20 4Z"></path><path d="m11 7 3 12 12 3M7 26l12-8"></path></svg></div><h3>Відкриття<br/>під ключ</h3><p>Ідея → готовий заклад</p></div><div class="capability"><div class="capability-top"><span class="capability-no">02</span><svg class="capability-icon" fill="none" stroke="currentColor" viewbox="0 0 32 32"><path d="M26 9V3l-5 5h5M6 23v6l5-5H6"></path><path d="M25 8a12 12 0 0 0-20 8M7 24a12 12 0 0 0 20-8"></path></svg></div><h3>Перезапуск<br/>закладів</h3><p>Аудит та зміни процесів</p></div><div class="capability"><div class="capability-top"><span class="capability-no">03</span><svg class="capability-icon" fill="none" stroke="currentColor" viewbox="0 0 32 32"><path d="m16 2 13 7-13 7L3 9l13-7ZM3 16l13 7 13-7M3 23l13 7 13-7"></path></svg></div><h3>Ребрендинг<br/>та оновлення</h3><p>Нове позиціювання і меню</p></div><div class="capability"><div class="capability-top"><span class="capability-no">04</span><svg class="capability-icon" fill="none" stroke="currentColor" viewbox="0 0 32 32"><path d="M3 9h26M3 23h26M8 4v10m0 5v10m16-25v10m0 5v10"></path><circle cx="8" cy="16" fill="var(--cream2)" r="3"></circle><circle cx="24" cy="16" fill="var(--cream2)" r="3"></circle></svg></div><h3>Окремі<br/>послуги</h3><p>Меню, персонал, оснащення</p></div></div></div></section>
<section class="portfolio" id="projects"><div class="container portfolio-top"><div class="reveal"><div class="label light-label">02 / Портфоліо</div><h2 class="intro-title">Реальні заклади.<br/><em>Реальний досвід.</em></h2></div><div class="portfolio-controls"><button aria-label="Попередній проєкт" class="icon-btn" id="projectPrev" type="button">←</button><button aria-label="Наступний проєкт" class="icon-btn" id="projectNext" type="button">→</button></div></div>
<div aria-label="Приклади проєктів" class="portfolio-slider" id="projectSlider">
<button aria-label="Детальніше про Grey Stone" class="project" data-desc="Ресторан Grey Stone у Софіївській Борщагівці — приклад реалізованого закладу з портфоліо команди. Фото фасаду надане замовником." data-img="assets/greystone.webp" data-title="Grey Stone" data-type="Ресторан · Софіївська Борщагівка" type="button"><div class="project-image" style="background-image:url('assets/greystone.webp')"></div><div class="project-info"><span class="project-index">ПРОЄКТ / 01</span><h3>Grey Stone</h3><p>Ресторан · Софіївська Борщагівка</p></div><span class="project-go">↗</span></button>
<button aria-label="Детальніше про Eat It" class="project" data-desc="Заклад молодіжного формату при житловому комплексі. Фото фасаду — з матеріалів замовника." data-img="assets/eatit.webp" data-title="EAT IT" data-type="Молодіжне кафе · Формат при ЖК" type="button"><div class="project-image" style="background-image:url('assets/eatit.webp')"></div><div class="project-info"><span class="project-index">ПРОЄКТ / 02</span><h3>EAT IT</h3><p>Молодіжне кафе · Формат при ЖК</p></div><span class="project-go">↗</span></button>
<button aria-label="Детальніше про Red Cat Pub" class="project" data-desc="Досвід запусків кухонь для закладів мережі Red Cat у Харкові. На фото — один із закладів Red Cat Pub." data-img="assets/redcat.webp" data-title="Red Cat Pub" data-type="Паб · Харків" type="button"><div class="project-image" style="background-image:url('assets/redcat.webp')"></div><div class="project-info"><span class="project-index">ПРОЄКТ / 03</span><h3>Red Cat Pub</h3><p>Паб · Харків</p></div><span class="project-go">↗</span></button>
<button aria-label="Детальніше про Готові страви поруч" class="project" data-desc="Формат готових, домашніх та корисних страв. На фото — оформлення фасаду одного з проєктів." data-img="assets/ready-food.webp" data-title="Готові страви поруч" data-type="Формат готових страв" type="button"><div class="project-image" style="background-image:url('assets/ready-food.webp')"></div><div class="project-info"><span class="project-index">ПРОЄКТ / 04</span><h3>Готові страви поруч</h3><p>Формат готових страв</p></div><span class="project-go">↗</span></button>
</div><div class="container"><div class="portfolio-note">Фото із матеріалів замовника. Перед публічним запуском погодимо назви брендів і точний перелік робіт команди в кожному кейсі.</div></div></section><section class="kitchen-story" id="kitchens">
<div class="container kitchen-story-head reveal">
<div><div class="label">03 / Залаштунки запуску</div><h2 class="intro-title">Те, що гість<br/><em>не бачить.</em></h2></div>
<p class="description">За кожним відкриттям — десятки невидимих рішень: технологія кухні, обладнання, ергономіка, процеси та люди. Ось реальні робочі кадри з наданих проєктів.</p>
</div>
<div class="container kitchen-pair">
<figure class="kitchen-shot reveal"><img alt="Професійна кухня на етапі облаштування, обладнання ще розпаковують" loading="lazy" src="assets/kitchen-install.webp"/><figcaption><span>01 / ПІДГОТОВКА</span><strong>Облаштування кухні</strong></figcaption></figure>
<figure class="kitchen-shot kitchen-shot-lower reveal"><img alt="Робоча професійна кухня з обладнанням і продуктами" loading="lazy" src="assets/kitchen-work.webp"/><figcaption><span>02 / РОБОТА</span><strong>Налагоджені процеси</strong></figcaption></figure>
</div>
<div class="container kitchen-foot"><span>Фото з матеріалів команди, не порівняння одного приміщення «до / після».</span><a class="text-link" href="#process">Як ми запускаємо <span>↗</span></a></div>
</section>
<section class="formats" id="services"><div class="container formats-grid"><div class="reveal"><div class="label">04 / Формати</div><h2 class="intro-title">Від кави<br/>на виніс до<br/><em>ресторану.</em></h2><p class="description">Підбираємо рішення під ідею, площу та інвестиції. Працюємо як із новими підприємцями, так і з власниками діючих закладів.</p><a class="text-link" href="#contact" style="margin-top:15px">Підібрати формат <span>↗</span></a></div><div class="format-list reveal"><a aria-label="Обговорити формат: Ресторани та паби" class="format-row" data-prefill="Ресторан / паб" href="#contact"><span class="num">01</span><strong>Ресторани та паби</strong><span class="plus">↗</span></a><a aria-label="Обговорити формат: Кав'ярні та пекарні" class="format-row" data-prefill="Кав’ярня / пекарня" href="#contact"><span class="num">02</span><strong>Кав'ярні та пекарні</strong><span class="plus">↗</span></a><a aria-label="Обговорити формат: Бургерні, піцерії, суші" class="format-row" data-prefill="Стрітфуд / фастфуд" href="#contact"><span class="num">03</span><strong>Бургерні, піцерії, суші</strong><span class="plus">↗</span></a><a aria-label="Обговорити формат: Стрітфуд та фастфуд" class="format-row" data-prefill="Стрітфуд / фастфуд" href="#contact"><span class="num">04</span><strong>Стрітфуд та фастфуд</strong><span class="plus">↗</span></a><a aria-label="Обговорити формат: Dark kitchen та доставка" class="format-row" data-prefill="Dark kitchen / доставка" href="#contact"><span class="num">05</span><strong>Dark kitchen та доставка</strong><span class="plus">↗</span></a><a aria-label="Обговорити формат: Індивідуальні концепції" class="format-row" data-prefill="Ще не визначився" href="#contact"><span class="num">06</span><strong>Індивідуальні концепції</strong><span class="plus">↗</span></a></div></div></section>
<section class="expert" id="expert"><div class="container expert-grid"><div aria-label="Портрет Дмитра, бренд-шефа та керівника ресторанних проєктів" class="expert-visual reveal" role="img"><img alt="Дмитро — бренд-шеф та фахівець із запуску закладів" class="expert-portrait" loading="lazy" src="assets/dmytro.webp"/><div class="expert-stamp">ДОСВІД<br/>З 2012<br/>РОКУ</div><div class="expert-card-text"><div class="label">Засновник і керівник</div><h3>Дмитро</h3><span>Бренд-шеф · Керівник ресторанних проєктів</span></div></div><div class="expert-copy reveal"><div class="label">05 / Експертиза</div><h2 class="intro-title">Знаємо<br/>кухню. <em>І бізнес</em><br/>зсередини.</h2><p class="description">У ресторанній сфері з 2012 року. Відкривав і перезапускав заклади різних форматів по Україні: від стрітфуду та кав’ярень до пивних ресторанів. Має профільну освіту технолога харчової промисловості та досвід роботи за кордоном.</p><p class="description">Наш підхід — відкривати не заради кількості. Кожен проєкт має бути продуманим, а результат — гідним нашої репутації.</p><ul class="credentials"><li><span>01</span> Диплом технолога харчової промисловості</li><li><span>02</span> Практичний досвід за кордоном</li><li><span>03</span> Запуск та перезапуск різних форматів</li><li><span>04</span> Команда перевірених спеціалістів</li></ul></div></div></section><section class="food-story" id="food">
<div class="container food-heading reveal"><div class="label light-label">06 / Кухня та меню</div><h2 class="intro-title">Смак починається<br/><em>з системи.</em></h2><p>Меню, технологічні карти, навчання персоналу й подача — не декор, а частина робочої моделі закладу.</p></div>
<div class="food-mosaic container">
<figure class="food-tile food-tile-a reveal"><img alt="Паста з креветками та зеленим соусом" loading="lazy" src="assets/dish-pasta.webp"/><figcaption>Авторське меню</figcaption></figure>
<figure class="food-tile food-tile-b reveal"><img alt="Ресторанна подача страви з ефектом диму" loading="lazy" src="assets/dish-show.webp"/><figcaption>Подача та враження</figcaption></figure>
<figure class="food-tile food-tile-c reveal"><img alt="Бургер на чорній булочці" loading="lazy" src="assets/dish-burger.webp"/><figcaption>Формати fast casual</figcaption></figure>
<figure class="food-tile food-tile-d reveal"><img alt="Креветки на авторській керамічній тарілці" loading="lazy" src="assets/dish-shrimp.webp"/><figcaption>Деталі, що запам'ятовуються</figcaption></figure>
</div>
<div class="container food-bottom"><span>Реальні фото страв із матеріалів замовника</span><a class="text-link" href="#contact">Обговорити меню <span>↗</span></a></div>
</section>
<section class="process" id="process"><div class="container"><div class="section-heading reveal"><div><div class="label light-label">07 / Процес</div><h2 class="intro-title">Шлях до<br/><em>відкритих дверей.</em></h2></div><p class="description">Від першої розмови до запуску та місяця супроводу. Кожен етап має зрозумілу мету й конкретний результат.</p></div><div class="step-grid"><div class="step reveal"><div class="step-no">01.</div><h3>Знайомство й аналіз</h3><p>Зустріч, консультація, оцінка ідеї, формату та бюджету.</p></div><div class="step reveal"><div class="step-no">02.</div><h3>Концепція та план</h3><p>Локація, аудиторія, бізнес-план, назва, меню та фінансова модель.</p></div><div class="step reveal"><div class="step-no">03.</div><h3>Підготовка закладу</h3><p>Проєктування, ремонт, підрядники, обладнання, постачальники й персонал.</p></div><div class="step reveal"><div class="step-no">04.</div><h3>Запуск і підтримка</h3><p>Документи, автоматизація, навчання команди, відкриття та місяць супроводу.</p></div></div><div class="process-footer"><p>* Більшість запусків триває орієнтовно 1,5–3 місяці. Для масштабних проєктів термін може бути довшим.</p><a class="text-link" href="#contact">Почати свій проєкт <span>↗</span></a></div></div></section>
<section class="pricing" id="pricing"><div class="container"><div class="pricing-heading reveal"><div><div class="label">08 / Вартість</div><h2 class="intro-title">Ідея має<br/><em>свій масштаб.</em></h2></div><p class="description">Обери орієнтовну площу — покажемо попередню вартість роботи команди та окремо діапазон інвестицій у сам заклад. Остаточний кошторис складаємо під проєкт.</p></div><div class="pricing-panel reveal"><div class="pricing-selector"><h3 class="serif">Площа закладу</h3><p>Обери один із типових форматів</p><div aria-label="Площа закладу" class="size-options" role="group"><button aria-pressed="true" class="size-option active" data-size="0" type="button">До 20 м²</button><button aria-pressed="false" class="size-option" data-size="1" type="button">20–40 м²</button><button aria-pressed="false" class="size-option" data-size="2" type="button">40–60 м²</button><button aria-pressed="false" class="size-option" data-size="3" type="button">60–80 м²</button></div></div><div aria-live="polite" class="pricing-output"><div class="output-head"><span>Робота команди під ключ</span><span class="output-badge">Попередній розрахунок</span></div><div class="large-price" id="servicePrice">$2 800</div><div class="price-text">Орієнтовна вартість наших послуг для площі <strong id="activeSize">до 20 м²</strong></div><div class="budget-breakdown"><div><span>Інвестиції у відкриття закладу</span><span>ремонт, обладнання, запуск — окремо від наших послуг</span></div><strong id="investmentRange">$10–18 тис.</strong></div></div></div><div class="pricing-disclaimer"><span>✳</span><span>Цифри надані клієнтом як попередній орієнтир. Робота команди та інвестиції в заклад оплачуються окремо. Бюджет залежить від міста, площі, приміщення й формату; це не гарантія окупності. Понад 80 м² — індивідуальний розрахунок.</span></div><a class="button button-dark" href="#contact" style="margin-top:30px">Отримати персональний розрахунок <span class="display-arrow">↗</span></a></div></section>
<section class="faq" id="questions"><div class="container faq-grid"><div class="reveal"><div class="label">09 / Запитання</div><h2 class="intro-title">Все важливе<br/><em>до старту.</em></h2><p class="description">Не знайшов відповіді? Розберемо твій випадок на першій консультації.</p></div><div class="faq-list reveal"><details><summary>Чи потрібне власне приміщення?</summary><p>Ні. Можемо допомогти підібрати приміщення й оцінити локацію, цільову аудиторію та фінансові параметри.</p></details><details><summary>Чи працюєте з уже відкритими закладами?</summary><p>Так. Допомагаємо з аудитом, перезапуском, ребрендингом, оновленням меню та окремими операційними напрямками.</p></details><details><summary>Можна замовити лише одну послугу?</summary><p>Так. Доступні окремі завдання — від технологічних карт і меню до підбору обладнання, постачальників та навчання персоналу.</p></details><details><summary>Скільки триває відкриття?</summary><p>Зазвичай 1,5–3 місяці, але великі та складні проєкти можуть потребувати більше часу. Точні строки визначаємо після аналізу.</p></details><details><summary>Що відбувається після запуску?</summary><p>Передбачений супровід протягом одного місяця після відкриття.</p></details><details><summary>У яких містах працюєте?</summary><p>Працюємо з проєктами по всій Україні. Формат участі узгоджуємо відповідно до локації та завдань.</p></details></div></div></section>
<section aria-labelledby="manifesto-title" class="manifesto"><div class="container manifesto-grid">
<div class="manifesto-index">НАШ ПІДХІД / 001</div>
<h2 id="manifesto-title">Ми відкриваємо не просто<br/><em>двері.</em> Ми запускаємо <span>справу.</span></h2>
<div class="manifesto-action"><p>Ідея. План. Простір. Команда. Меню. Перший гість. І підтримка після відкриття.</p><a class="text-link" href="#contact">Створити свій заклад <span aria-hidden="true">↗</span></a></div>
</div></section><section class="contact" id="contact"><div class="container contact-grid"><div class="reveal"><div class="label light-label">10 / Контакти</div><h2 class="intro-title">Почнемо<br/>з <em>розмови.</em></h2><p class="contact-lead">Плануєте відкрити заклад або оновити діючий бізнес? Розкажіть про вашу ідею. Підготуємо перші питання та визначимо наступні кроки.</p><div class="contact-meta">Майбутній проєкт починається тут</div></div><div class="form-box reveal"><h3 class="serif">Твоя ідея — наш початок.</h3><p class="form-sub">Залиш деталі, щоб підготувати звернення для команди.</p><form id="leadForm" novalidate=""><div class="field-row"><div class="field"><label for="leadName">Як тебе звати *</label><input autocomplete="name" id="leadName" maxlength="100" name="name" placeholder="Ім'я" required=""/></div><div class="field"><label for="leadPhone">Телефон або Telegram *</label><input autocomplete="tel" id="leadPhone" maxlength="100" name="phone" placeholder="+380 або @username" required=""/></div></div><div class="field-row"><div class="field"><label for="leadFormat">Тип проєкту</label><select id="leadFormat" name="format"><option value="Ще не визначився">Ще не визначився</option><option>Ресторан / паб</option><option>Кав'ярня / пекарня</option><option>Стрітфуд / фастфуд</option><option>Dark kitchen / доставка</option><option>Перезапуск / ребрендинг</option><option>Окрема послуга</option></select></div><div class="field"><label for="leadCity">Місто</label><input id="leadCity" maxlength="100" name="city" placeholder="Де планується заклад"/></div></div><div class="field"><label for="leadArea">Площа закладу</label><select id="leadArea" name="area"><option value="Ще не знаю">Ще не знаю</option><option>До 20 м²</option><option>20–40 м²</option><option>40–60 м²</option><option>60–80 м²</option><option>Понад 80 м²</option></select></div><div class="field"><label for="leadComment">Трохи про ідею</label><textarea id="leadComment" name="comment" placeholder="Що хочеш відкрити, чи є приміщення, приблизний бюджет..."></textarea></div><button class="button button-dark form-submit" type="submit">Підготувати звернення <span class="display-arrow">↗</span></button><p class="form-note">Демо: заявка не відправляється. Після заповнення можна скопіювати дані й передати їх команді. Перед запуском підключимо реальне надсилання та політику приватності.</p><div aria-live="polite" class="form-status" id="formStatus"></div><button class="copy-btn" id="copyLead" type="button">Скопіювати текст заявки</button></form></div></div></section><a class="mobile-fixed-cta" href="#contact">Обговорити відкриття <span aria-hidden="true">↗</span></a>
</main>
<footer class="footer"><div class="container"><div class="footer-top"><a aria-label="Gastro Atelier — на головну" class="brand" href="#top"><img alt="Gastro Atelier — студія ресторанних проєктів" class="brand-artwork" decoding="async" src="assets/brand-horizontal.webp"/></a><div class="footer-links"><a href="#about">Про нас</a><a href="#services">Послуги</a><a href="#projects">Проєкти</a><a href="#pricing">Вартість</a><a href="#contact">Зв'язатися</a></div></div><div class="footer-bottom"><span>© 2026 GASTRO ATELIER · Концепція бренду для погодження. Фото надані замовником.</span><span>Зроблено з увагою до кожної деталі.</span></div></div></footer>
<button aria-label="Нагору" class="floating-to-top" id="toTop" type="button">↑</button>
<div aria-hidden="true" aria-labelledby="modalTitle" aria-modal="true" class="modal" id="projectModal" role="dialog"><div class="modal-inner"><div class="modal-visual" id="modalVisual"></div><div class="modal-body"><div class="modal-tag" id="modalType"></div><h3 id="modalTitle">Назва проєкту</h3><p id="modalDesc"></p><a class="button button-dark" href="#contact" id="modalAction">Обговорити схожий проєкт <span>↗</span></a></div><button aria-label="Закрити" class="modal-close" id="modalClose" type="button">×</button></div></div>
<script>
(function(){'use strict';
 const header=document.getElementById('siteHeader'),bar=document.getElementById('progress'),topBtn=document.getElementById('toTop');
 let scrollTick=false;
 function updateScroll(){let y=window.scrollY, max=document.documentElement.scrollHeight-window.innerHeight;header.classList.toggle('is-scrolled',y>30);topBtn.classList.toggle('visible',y>700);bar.style.width=(max>0?Math.min(100,y/max*100):0)+'%';scrollTick=false;}
 window.addEventListener('scroll',()=>{if(!scrollTick){scrollTick=true;requestAnimationFrame(updateScroll)}},{passive:true});updateScroll();
 topBtn.addEventListener('click',()=>window.scrollTo({top:0,behavior:window.matchMedia('(prefers-reduced-motion:reduce)').matches?'instant':'smooth'}));
 const menu=document.getElementById('mobileMenu'),menuToggle=document.getElementById('menuToggle'),menuClose=document.getElementById('menuClose');
 function setMenu(open){menu.classList.toggle('open',open);menu.setAttribute('aria-hidden',String(!open));menuToggle.setAttribute('aria-expanded',String(open));document.body.classList.toggle('menu-open',open);if(open)menuClose.focus();else menuToggle.focus();}
 menuToggle.addEventListener('click',()=>setMenu(true));menuClose.addEventListener('click',()=>setMenu(false));menu.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>setMenu(false)));
 const reveals=document.querySelectorAll('.reveal');if('IntersectionObserver' in window){let ob=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in-view');ob.unobserve(e.target)}})},{threshold:.07,rootMargin:'0px 0px -30px 0px'});reveals.forEach(e=>ob.observe(e));}else reveals.forEach(e=>e.classList.add('in-view'));
 const slider=document.getElementById('projectSlider');document.getElementById('projectPrev').addEventListener('click',()=>slider.scrollBy({left:-slider.clientWidth*.72,behavior:'smooth'}));document.getElementById('projectNext').addEventListener('click',()=>slider.scrollBy({left:slider.clientWidth*.72,behavior:'smooth'}));
 const data=[{service:'$2 800',size:'до 20 м²',invest:'$10–18 тис.'},{service:'$3 300',size:'20–40 м²',invest:'$15–25 тис.'},{service:'$3 600',size:'40–60 м²',invest:'$20–40 тис.'},{service:'$4 800',size:'60–80 м²',invest:'$35–65 тис.'}];
 const opts=[...document.querySelectorAll('.size-option')];opts.forEach(b=>b.addEventListener('click',()=>{let d=data[Number(b.dataset.size)];document.getElementById('servicePrice').textContent=d.service;document.getElementById('activeSize').textContent=d.size;document.getElementById('investmentRange').textContent=d.invest;opts.forEach(o=>{let active=o===b;o.classList.toggle('active',active);o.setAttribute('aria-pressed',String(active));});}));
 const modal=document.getElementById('projectModal');const closeModal=()=>{modal.classList.remove('open');modal.setAttribute('aria-hidden','true');document.body.classList.remove('dialog-open');if(lastTrigger)lastTrigger.focus();};let lastTrigger=null;
 document.querySelectorAll('.project').forEach(b=>b.addEventListener('click',()=>{lastTrigger=b;document.getElementById('modalTitle').textContent=b.dataset.title;document.getElementById('modalType').textContent=b.dataset.type;document.getElementById('modalDesc').textContent=b.dataset.desc;document.getElementById('modalVisual').style.backgroundImage=`url('${b.dataset.img}')`;modal.classList.add('open');modal.setAttribute('aria-hidden','false');document.body.classList.add('dialog-open');document.getElementById('modalClose').focus();}));
 document.getElementById('modalClose').addEventListener('click',closeModal);document.getElementById('modalAction').addEventListener('click',closeModal);modal.addEventListener('click',e=>{if(e.target===modal)closeModal()});document.addEventListener('keydown',e=>{if(e.key==='Escape'){if(modal.classList.contains('open'))closeModal();else if(menu.classList.contains('open'))setMenu(false);}});
 const form=document.getElementById('leadForm'),status=document.getElementById('formStatus'),copy=document.getElementById('copyLead');let leadText='';
 form.addEventListener('submit',e=>{e.preventDefault();let name=document.getElementById('leadName').value.trim(),phone=document.getElementById('leadPhone').value.trim();if(name.length<2||phone.length<3){status.textContent='Вкажи ім’я та телефон або Telegram, щоб сформувати звернення.';status.classList.add('show');copy.classList.remove('show');return;}let fmt=document.getElementById('leadFormat').value,city=document.getElementById('leadCity').value.trim()||'Не вказано',comment=document.getElementById('leadComment').value.trim()||'Без коментаря';leadText=`Нова заявка з сайту GASTRO ATELIER\nІм’я: ${name}\nКонтакт: ${phone}\nТип проєкту: ${fmt}\nПлоща: ${document.getElementById("leadArea")?.value || "Не вказано"}\nМісто: ${city}\nКоментар: ${comment}`;status.textContent='Звернення сформоване. Натисни «Скопіювати текст заявки» та передай його в потрібний месенджер. Після підключення CRM відправка буде автоматичною.';status.classList.add('show');copy.classList.add('show');});
 copy.addEventListener('click',async()=>{try{if(navigator.clipboard&&window.isSecureContext){await navigator.clipboard.writeText(leadText)}else{let el=document.createElement('textarea');el.value=leadText;el.style.position='fixed';el.style.opacity='0';document.body.appendChild(el);el.select();if(!document.execCommand('copy'))throw new Error('no-copy');el.remove()}status.textContent='Текст звернення скопійовано. Його можна вставити у повідомлення.'}catch(_){status.textContent='Автоматичне копіювання недоступне в цьому браузері. Виділи текст у вікні та скопіюй вручну.';window.prompt('Скопіюй звернення:',leadText)}});
})();


(function(){
  const format=document.getElementById('leadFormat');
  const area=document.getElementById('leadArea');
  const comment=document.getElementById('leadComment');
  const sizeNames=['До 20 м²','20–40 м²','40–60 м²','60–80 м²'];
  // Every formatted service row should lead to a meaningful draft, not an inert arrow.
  document.querySelectorAll('.format-row[data-prefill]').forEach(link=>link.addEventListener('click',()=>{
    const wanted=link.dataset.prefill;
    if(!format)return;
    const candidate=[...format.options].find(o=>o.textContent.trim().replace('’',"'")===wanted.replace('’',"'"));
    if(candidate) format.value=candidate.value;
    if(!comment.value.trim())comment.value='Цікавить формат: '+link.querySelector('strong').textContent.trim()+'.';
  }));
  document.querySelectorAll('.size-option').forEach((btn,i)=>btn.addEventListener('click',()=>{if(area)area.value=sizeNames[i]}));
  // Hide persistent CTA when contact form is within viewport to keep the form uncovered.
  const cta=document.querySelector('.mobile-fixed-cta');
  const section=document.getElementById('contact');
  let formVisible=false;
  function refreshCta(){
    if(cta) cta.style.visibility=(window.innerWidth<=760 && window.scrollY>Math.max(540,window.innerHeight*.75) && !formVisible)?'visible':'hidden';
  }
  if(cta && section && 'IntersectionObserver' in window){
    new IntersectionObserver(entries=>{formVisible=entries[0].isIntersecting;refreshCta()},{threshold:.12}).observe(section);
  }
  window.addEventListener('scroll',refreshCta,{passive:true});window.addEventListener('resize',refreshCta);refreshCta();
})();
</script>
</body>
</html>
